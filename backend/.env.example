# Puerto del servidor
PORT=3001

# GitHub Configuration
# Obtener token en: https://github.com/settings/tokens
# Permisos requeridos: repo (acceso completo a repos privados)
GITHUB_TOKEN=ghp_tu_token_aqui_1234567890

# Formato: owner/repository (ej: tu-usuario/cotizaciones)
GITHUB_REPO=tu-usuario/cotizaciones
