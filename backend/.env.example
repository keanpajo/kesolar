# Puerto del servidor
PORT=3001

# GitHub Configuration
# Obtener token en: https://github.com/settings/tokens
# Permisos requeridos: repo (acceso completo a repos)
GITHUB_TOKEN=ghp_tu_token_aqui_1234567890

# Tu repositorio actual (ej: keanpajo/kesolar)
GITHUB_REPO=keanpajo/kesolar

# Rama donde guardar (default: main)
GITHUB_BRANCH=main
